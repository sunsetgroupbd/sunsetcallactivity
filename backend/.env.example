# Environment Configuration
# Copy this file to .env and fill in real values
# Never commit .env to version control

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="Sunset Group Dashboard"
APP_VERSION="1.0.0"
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────────────
# Docker Compose PostgreSQL on VPS:
DATABASE_URL=postgresql://sunset_user:strongpassword@db:5432/sunset_dashboard
POSTGRES_USER=sunset_user
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=sunset_dashboard

# Standalone PostgreSQL (e.g. Supabase, Neon, or local PostgreSQL):
# DATABASE_URL=postgresql://sunset_user:strongpassword@localhost:5432/sunset_dashboard

# SQLite fallback (quick local dev):
# DATABASE_URL=sqlite:///./sunset_dashboard.db

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate on Linux/VPS with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# IMPORTANT FOR PRODUCTION: Add all production domains here!
# Example: https://call.sunsetgroupbd.com,http://localhost:3000
ALLOWED_ORIGINS=https://call.sunsetgroupbd.com,https://callapi.sunsetgroupbd.com,https://sunset-dashboard.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ─── Business Configuration ───────────────────────────────────────────────────
BUSINESS_TIMEZONE=Asia/Dhaka

# ─── Cookie Security ──────────────────────────────────────────────────────────
# Set to true in production when behind HTTPS/SSL
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ─── Somikoron CRM Integration ────────────────────────────────────────────────
# External CRM lead list integration (https://sunset.somikoronitltd.com)
CRM_BASE_URL=https://sunset.somikoronitltd.com
CRM_LOGIN_URL=https://sunset.somikoronitltd.com/login
CRM_LEADS_URL=https://sunset.somikoronitltd.com/crm-module/lead_data
CRM_USERNAME=your_crm_login_email_or_username
CRM_PASSWORD=your_crm_password
CRM_USERNAME_FIELD=email
CRM_PASSWORD_FIELD=password
# Optional: If your CRM uses static Bearer token instead of password login:
# CRM_AUTH_TOKEN=your_api_token_here

